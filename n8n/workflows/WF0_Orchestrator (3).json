            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "wf0-c1",
              "leftValue": "={{ $json.intent }}",
              "rightValue": "BOOK",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
