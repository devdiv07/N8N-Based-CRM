              "leftValue": "={{ parseInt($json.FOLLOW_UP_COUNT || '0') }}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
