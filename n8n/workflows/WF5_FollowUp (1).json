      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "id": "wf5-node-003",
      "name": "Filter Eligible for Follow-Up"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lastContact = $input.item.json.LAST_CONTACT;\nconst now = new Date();\nconst last = lastContact ? new Date(lastContact) : new Date(0);\nconst hoursSinceContact = (now.getTime() - last.getTime()) / (1000 * 60 * 60);\n$input.item.json.hours_since_contact = hoursSinceContact;\n$input.item.json.eligible = hoursSinceContact >= 24;\n$input.item.json.attempt_number = parseInt($input.item.json.FOLLOW_UP_COUNT || '0') + 1;\nreturn $input.item;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "wf5-node-004",
      "name": "Check Time Since Last Contact"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "wf5-c5",
              "leftValue": "={{ $json.eligible }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "id": "wf5-node-005",
      "name": "Only 24h+ Since Contact"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a follow-up email for this lead:\n\nName: {{ $json.NAME }}\nEmail: {{ $json.EMAIL }}\nService interested in: {{ $json.SERVICE || 'our services' }}\nCurrent status: {{ $json.STATUS }}\nFollow-up attempt: {{ $json.attempt_number }} of 3\nHours since last contact: {{ Math.round($json.hours_since_contact) }}\nPrevious notes: {{ $json.NOTES || 'None' }}",
        "options": {
          "systemMessage": "You are an AI Sales Follow-Up Agent writing personalized follow-up emails.\n\nRules by attempt number:\n\nATTEMPT 1 — Friendly Check-In:\n- Warm and casual tone\n- Reference their specific service interest\n- Offer to answer any questions\n- Light call-to-action to book a call\n\nATTEMPT 2 — Value Add:\n- Add soft urgency (limited availability)\n- Mention a specific benefit\n- More direct CTA — offer a specific next step\n\nATTEMPT 3 — Final Reach-Out:\n- Direct but respectful\n- Create FOMO — this is the last follow-up\n- Strong CTA\n- Say this is the final automated message\n\nRules:\n- Write ONLY the email body. No subject line.\n- Under 150 words\n- Do NOT mention you are AI\n- Sign as: The Team\n- Sound like a real human"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1100,
        0
      ],
      "id": "wf5-node-006",
      "name": "AI Follow-Up Agent"
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1100,
        220
      ],
      "id": "wf5-node-007",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "fromEmail": "hithereitsme0011@gmail.com",
        "toEmail": "={{ $('Only 24h+ Since Contact').item.json.EMAIL }}",
        "subject": "={{ $('Only 24h+ Since Contact').item.json.attempt_number === 1 ? 'Quick question about ' + ($('Only 24h+ Since Contact').item.json.SERVICE || 'your inquiry') : $('Only 24h+ Since Contact').item.json.attempt_number === 2 ? 'Don\\'t miss out — ' + ($('Only 24h+ Since Contact').item.json.SERVICE || 'special offer') : 'Final follow-up — ' + $('Only 24h+ Since Contact').item.json.NAME }}",
        "emailFormat": "text",
        "text": "={{ $json.output }}",
