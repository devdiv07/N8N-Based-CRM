    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "1RVCaFsjWKDItYhARAzlZl9D6PT5arCxHZ82dEooPXbc",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "LeadPipeline",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "NAME": "={{ $json.name }}",
            "EMAIL": "={{ $json.email }}",
            "PHONE": "={{ $json.phone }}",
            "SOURCE": "={{ $json.source }}",
            "STATUS": "NEW",
            "SERVICE": "={{ $json.service }}",
            "MESSAGE": "={{ $json.message }}",
            "LEAD_SCORE": "WARM",
            "BOOKED": "FALSE",
            "CREATED_AT": "={{ $json.created_at }}",
            "LAST_CONTACT": "={{ $json.created_at }}",
            "FOLLOW_UP_COUNT": "0"
          },
          "matchingColumns": [
            "EMAIL"
          ],
          "schema": []
        },
        "options": {
          "matchingColumn": "EMAIL"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "EMAIL",
              "lookupValue": "={{ $json.body?.email || $json.email }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        440,
        0
      ],
      "id": "wf1-node-003",
      "name": "Log Lead to CRM"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=New website inquiry from {{ $('Extract Lead Data').item.json.name }}:\n\n{{ $('Extract Lead Data').item.json.message }}\n\nService interested in: {{ $('Extract Lead Data').item.json.service || 'not specified' }}\nTheir email: {{ $('Extract Lead Data').item.json.email }}",
        "options": {
          "systemMessage": "You are a professional AI Sales Assistant.\n\nYour job:\n1. Respond warmly and personally to the inquiry\n2. Address exactly what they asked about\n3. Show genuine interest in helping them\n4. Briefly explain how you can help with their specific need\n5. End with ONE clear call to action — invite them to book a free consultation\n6. Keep under 150 words\n7. Sound like a real human, not a robot\n8. Never mention you are AI\n9. Sign as: The Support Team"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        660,
        0
      ],
      "id": "wf1-node-004",
      "name": "AI Sales Agent"
    },
    {
