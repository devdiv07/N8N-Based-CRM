      "id": "wf4-node-002",
      "name": "Extract Booking Data"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let date = $input.item.json.preferred_date;\nlet time = $input.item.json.preferred_time || '10:00';\n\n// Validate date format (YYYY-MM-DD)\nif (!date || typeof date !== 'string' || !/^\\d{4}-\\d{2}-\\d{2}$/.test(date.trim())) {\n  // Fallback: use tomorrow\n  const tomorrow = new Date();\n  tomorrow.setDate(tomorrow.getDate() + 1);\n  date = tomorrow.toISOString().split('T')[0];\n}\n\n// Validate time format (HH:MM)\nif (!/^\\d{2}:\\d{2}$/.test(time.trim())) {\n  time = '10:00';\n}\n\nconst startDateTime = new Date(`${date.trim()}T${time.trim()}:00`);\n\n// Final safety check\nif (isNaN(startDateTime.getTime())) {\n  throw new Error(`Cannot parse booking date/time: date='${date}', time='${time}'`);\n}\n\nconst endDateTime = new Date(startDateTime.getTime() + 60 * 60 * 1000);\nconst dayStart = new Date(`${date.trim()}T00:00:00`);\nconst dayEnd = new Date(`${date.trim()}T23:59:59`);\n$input.item.json.booking_start = startDateTime.toISOString();\n$input.item.json.booking_end = endDateTime.toISOString();\n$input.item.json.day_start = dayStart.toISOString();\n$input.item.json.day_end = dayEnd.toISOString();\n$input.item.json.booking_display_date = startDateTime.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });\n$input.item.json.booking_display_time = `${time} - ${endDateTime.toTimeString().slice(0,5)}`;\nreturn $input.item;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "wf4-node-003",
      "name": "Build Booking DateTime"
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list",
          "cachedResultName": "Primary Calendar"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        660,
        0
      ],
      "id": "wf4-node-004",
      "name": "Check Calendar Availability"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst bookingData = $('Build Booking DateTime').first().json;\nconst requestedStart = new Date(bookingData.booking_start);\nconst requestedEnd = new Date(bookingData.booking_end);\nlet isAvailable = true;\nlet conflictWith = '';\nfor (const item of items) {\n  const eventStart = item.json.start?.dateTime ? new Date(item.json.start.dateTime) : null;\n  const eventEnd = item.json.end?.dateTime ? new Date(item.json.end.dateTime) : null;\n  if (eventStart && eventEnd) {\n    if (requestedStart < eventEnd && requestedEnd > eventStart) {\n      isAvailable = false;\n      conflictWith = item.json.summary || 'Existing appointment';\n      break;\n    }\n  }\n}\nreturn [{ json: { ...bookingData, isAvailable, conflictWith } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "wf4-node-005",
      "name": "Check Slot Availability"
    },
    {
