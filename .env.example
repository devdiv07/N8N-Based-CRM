# Local development defaults only. Copy to .env and change values before use.

# Postgres
POSTGRES_DB=ai_crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678

# FastAPI / backend
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://crm:change-me@localhost:5432/ai_crm
REDIS_URL=redis://localhost:6379/0
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_INTERNAL_SECRET=change-me

# Optional integrations
OPENAI_API_KEY=
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GOOGLE_CREDENTIALS_PATH=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
